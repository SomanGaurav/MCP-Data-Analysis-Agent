# Copy to .env and fill in. Only the provider you select needs keys.

# Which LLM provider the agent host uses: ollama | gemini | groq
LLM_PROVIDER=ollama

# --- Ollama (local, default) ---
# Requires a running Ollama daemon + a tool-capable model, e.g. `ollama pull qwen2.5:3b`
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- Groq (free tier) --- https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (free tier) --- https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
